# For Docker: copy this file to ".env" next to docker-compose.yml and edit it.
# (Without Docker, set the same names as normal environment variables.)

# Password for the first "admin" account. Used only when the database is first created.
ADMIN_PASSWORD=admin123

# Optional fixed secret for login tokens. If empty, one is generated and saved in the data folder.
# JWT_SECRET=change-me-to-a-long-random-string
